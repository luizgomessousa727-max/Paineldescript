local function makeDraggable(guiObject)
	local dragging = false
	local dragInput, mousePos, framePos
	guiObject.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			mousePos = input.Position
			framePos = guiObject.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	guiObject.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - mousePos
			guiObject.Position = UDim2.new(
				framePos.X.Scale, framePos.X.Offset + delta.X,
				framePos.Y.Scale, framePos.Y.Offset + delta.Y
			)
		end
	end)
end

local function toggleMenu(mainFrame, mainScale)
	if menuState.isTweening then return end
	menuState.isTweening = true
	if not menuState.isOpen then
		mainFrame.Visible = true
		menuState.isOpen = true
		TweenService:Create(mainFrame, CONFIG.Tween.Info, {Size = CONFIG.Sizes.MenuOpen}):Play()
		TweenService:Create(mainScale, CONFIG.Tween.Info, {Scale = 1}):Play()
	else
		menuState.isOpen = false
		TweenService:Create(mainFrame, CONFIG.Tween.Info, {Size = CONFIG.Sizes.MenuClosed}):Play()
		TweenService:Create(mainScale, CONFIG.Tween.Info, {Scale = 0.85}):Play()
		task.wait(0.4)
		mainFrame.Visible = false
	end
	menuState.isTweening = false
end

local function addMenuButton(parentScrollingFrame, buttonText, callback)
	local button = Instance.new("TextButton")
	button.Name = "ScriptButton_" .. buttonText
	button.Size = UDim2.new(1, 0, 0, 38)
	button.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
	button.AutoButtonColor = false
	button.Font = Enum.Font.GothamSemibold
	button.Text = "  " .. buttonText
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.TextSize = 14
	button.TextXAlignment = Enum.TextXAlignment.Left
	button.Parent = parentScrollingFrame
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = button
	local stroke = Instance.new("UIStroke")
	stroke.Color = CONFIG.Colors.Stroke
	stroke.Transparency = 0.4
	stroke.Parent = button
	local buttonScale = Instance.new("UIScale")
	buttonScale.Scale = 1
	buttonScale.Parent = button
	button.MouseEnter:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(165, 75, 245)}):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(138, 43, 226)}):Play()
	end)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(buttonScale, TweenInfo.new(0.1), {Scale = 0.96}):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(buttonScale, TweenInfo.new(0.15), {Scale = 1}):Play()
	end)
	if callback then button.MouseButton1Click:Connect(callback) end
	return button
end

-- // MM2 ESP - DETECÇÃO POR ARMA (FUNCIONA NO MM2!)
local MM2ESPAtivo = false
local ESP_Objects = {}

local function iniciarMM2ESP()
	if MM2ESPAtivo then return end
	MM2ESPAtivo = true

	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local LocalPlayer = Players.LocalPlayer

	local ESP_CONFIG = {
		CorAssassino = Color3.fromRGB(255, 50, 50),      -- 🔴 VERMELHO
		CorXerife = Color3.fromRGB(50, 120, 255),         -- 🔵 AZUL
		CorInocente = Color3.fromRGB(50, 255, 80),        -- 🟢 VERDE
		CorDesconhecido = Color3.fromRGB(180, 180, 180)   -- ⚪ CINZA
	}

	local function criarTextoJogador(jogador)
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "ESP_MM2"
		billboard.AlwaysOnTop = true
		billboard.Size = UDim2.new(0, 180, 0, 50)
		billboard.StudsOffset = Vector3.new(0, 4.5, 0)
		local texto = Instance.new("TextLabel")
		texto.Name = "TextoESP"
		texto.Size = UDim2.new(1, 0, 1, 0)
		texto.BackgroundTransparency = 1
		texto.Font = Enum.Font.GothamBold
		texto.TextSize = 16
		texto.TextStrokeTransparency = 0
		texto.TextStrokeColor3 = Color3.new(0,0,0)
		texto.Parent = billboard
		return billboard, texto
	end

	-- ✅ DETECÇÃO PRINCIPAL: PELA ARMA (funciona no MM2)
	local function getRolePorArma(jogador)
		local char = jogador.Character
		local bp = jogador:FindFirstChild("Backpack")
		if not char then return "inocente" end

		-- Verifica Faca = Assassino
		local temFaca = false
		pcall(function()
			for _, v in ipairs(char:GetChildren()) do
				if v:IsA("Tool") and string.lower(v.Name):find("knife") then
					temFaca = true
				end
			end
			if bp then
				for _, v in ipairs(bp:GetChildren()) do
					if v:IsA("Tool") and string.lower(v.Name):find("knife") then
						temFaca = true
					end
				end
			end
		end)
		if temFaca then return "assassino" end

		-- Verifica Pistola = Xerife
		local temPistola = false
		pcall(function()
			for _, v in ipairs(char:GetChildren()) do
				if v:IsA("Tool") and (string.lower(v.Name):find("gun") or string.lower(v.Name):find("revolver") or string.lower(v.Name):find("sheriff")) then
					temPistola = true
				end
			end
			if bp then
				for _, v in ipairs(bp:GetChildren()) do
					if v:IsA("Tool") and (string.lower(v.Name):find("gun") or string.lower(v.Name):find("revolver") or string.lower(v.Name):find("sheriff")) then
						temPistola = true
					end
				end
			end
		end)
		if temPistola then return "xerife" end

		return "inocente"
	end

	RunService.Heartbeat:Connect(function()
		if not MM2ESPAtivo then return end
		for _, jogador in ipairs(Players:GetPlayers()) do
			if jogador ~= LocalPlayer and jogador.Character then
				local head = jogador.Character:FindFirstChild("Head")
				if head then
					if not ESP_Objects[jogador] then
						local bb, txt = criarTextoJogador(jogador)
						ESP_Objects[jogador] = { Billboard = bb, Texto = txt }
					end
					local dados = ESP_Objects[jogador]
					if not dados.Billboard.Parent then dados.Billboard.Parent = head end

					local role = getRolePorArma(jogador)
					local cor, label = ESP_CONFIG.CorDesconhecido, "⚪ "..jogador.Name

					if role == "assassino" then
						cor = ESP_CONFIG.CorAssassino
						label = "🔴 ASSASSINO 🔴\n"..jogador.Name
					elseif role == "xerife" then
						cor = ESP_CONFIG.CorXerife
						label = "🔫 XERIFE 🔫\n"..jogador.Name
					else
						cor = ESP_CONFIG.CorInocente
						label = "🟢 INOCENTE 🟢\n"..jogador.Name
					end

					dados.Texto.Text = label
					dados.Texto.TextColor3 = cor
				end
			end
		end
	end)
end

