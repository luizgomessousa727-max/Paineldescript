function ThemeSystem.Apply(themeName, bgImage)
	local theme = ThemeSystem.Themes[themeName]
	if not theme or not bgImage then return end
	bgImage.Image = theme.BackgroundImage
	ThemeSystem.Current = themeName
end
function ThemeSystem.Reset(bgImage)
	ThemeSystem.Apply("Default", bgImage)
	for _, callback in ipairs(ThemeSystem.ResetCallbacks) do task.spawn(callback) end
end

